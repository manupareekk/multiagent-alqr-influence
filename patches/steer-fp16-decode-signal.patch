+def expand_attention_mask_4d(attention_mask, dtype, device=None):
+    """HF Gemma2/4.57 expects a 4D additive mask (B,1,S,S), not a 2D pad mask."""
+    if attention_mask is None:
+        return None
+    if attention_mask.dim() == 4:
+        return attention_mask.to(dtype=dtype)
+    if attention_mask.dim() != 2:
+        return attention_mask
+    device = device or attention_mask.device
+    bsz, seq_len = attention_mask.shape
+    min_val = th.finfo(dtype).min
+    causal = th.zeros((seq_len, seq_len), device=device, dtype=dtype)
+    causal = causal.masked_fill(
+        th.triu(th.ones(seq_len, seq_len, device=device, dtype=th.bool), diagonal=1),
+        min_val,
+    )
+    mask = causal[None, None, :, :].expand(bsz, 1, seq_len, seq_len).clone()
+    pad = attention_mask.to(device) == 0
+    mask = mask.masked_fill(pad[:, None, None, :], min_val)
+    return mask
+
+
 def tf_block_wrapper(block, attention_mask, position_ids, position_embeddings, x): # 4.57
     x = x.unsqueeze(0)
